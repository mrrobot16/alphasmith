# Copy to .env.local and fill in. Leave blank to disable tracking.
NEXT_PUBLIC_SITE_URL=https://alphalocksmithngarage.com
NEXT_PUBLIC_GA_ID=            # GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=    # e.g. AW-123456789
NEXT_PUBLIC_ADS_CALL_CONVERSION=   # e.g. AW-123456789/AbCdEfGh (phone click)
NEXT_PUBLIC_ADS_LEAD_CONVERSION=   # e.g. AW-123456789/IjKlMnOp (quote form)

# Quote form email (Resend, https://resend.com). Without these, production shows
# a "please call us" error and dev just logs the lead to the terminal.
RESEND_API_KEY=   # re_xxxxxxxx
LEADS_TO_EMAIL=   # who gets the leads; comma-separate for several
LEADS_FROM_EMAIL=   # e.g. Alpha Website <leads@alphalocksmithngarage.com> (needs a verified domain)

# Quote form storage (MongoDB). Every lead is saved to the "leads" collection before
# the email goes out. Put the database name in the URI path. Blank = leads aren't saved.
MONGODB_URI=   # e.g. mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/alphasmith?retryWrites=true&w=majority

# Engagement tracking (all optional; blank = nothing loads or listens)
NEXT_PUBLIC_CLARITY_ID=   # Microsoft Clarity project ID: free visual click/scroll heatmaps + recordings
NEXT_PUBLIC_ANALYTICS_DEBUG=   # true = log every tracked event to the browser console

# 24/7 copy: auto (hide 10pm-6am Portland time), show (always), hide (never). Default auto.
NEXT_PUBLIC_HOURS_MODE=auto
