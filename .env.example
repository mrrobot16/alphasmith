# Copy to .env.local and fill in. Leave blank to disable tracking.
NEXT_PUBLIC_SITE_URL=https://alphalocksmithngarage.com
NEXT_PUBLIC_GA_ID=            # GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=    # e.g. AW-123456789
NEXT_PUBLIC_ADS_CALL_CONVERSION=   # e.g. AW-123456789/AbCdEfGh (phone click)
NEXT_PUBLIC_ADS_LEAD_CONVERSION=   # e.g. AW-123456789/IjKlMnOp (quote form)
