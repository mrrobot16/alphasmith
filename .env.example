# Copy to .env.local and fill in. Leave blank to disable tracking.
NEXT_PUBLIC_SITE_URL=https://alphalocksmithngarage.com
NEXT_PUBLIC_GA_ID=            # GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=    # e.g. AW-123456789
NEXT_PUBLIC_ADS_CALL_CONVERSION=   # e.g. AW-123456789/AbCdEfGh (phone click)
NEXT_PUBLIC_ADS_LEAD_CONVERSION=   # e.g. AW-123456789/IjKlMnOp (quote form)

# Quote form email (Resend, https://resend.com). Without these, production shows
# a "please call us" error and dev just logs the lead to the terminal.
RESEND_API_KEY=   # re_xxxxxxxx
LEADS_TO_EMAIL=   # who gets the leads; comma-separate for several
LEADS_FROM_EMAIL=   # e.g. Alpha Website <leads@alphalocksmithngarage.com> (needs a verified domain)

# Engagement tracking (all optional; blank = nothing loads or listens)
NEXT_PUBLIC_CLARITY_ID=   # Microsoft Clarity project ID: free visual click/scroll heatmaps + recordings
NEXT_PUBLIC_ANALYTICS_DEBUG=   # true = log every tracked event to the browser console

# Display ads (Google AdSense). DISABLED in code (see src/lib/ads.ts), so these do nothing for now.
# Everything is OFF while these are blank: no script, no request,
# no space on the page. See src/lib/ads.ts for the placements. Separate from the Google Ads
# conversion tracking above.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=   # publisher ID, e.g. ca-pub-1234567890123456 (also serves /ads.txt)
# NEXT_PUBLIC_ADSENSE_ENABLED=   # true = show the ads (needs the client ID and a slot ID)
# NEXT_PUBLIC_ADSENSE_PREVIEW=   # true = show dashed boxes where ads will go, no ad requests (for review)
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_MID=   # ad unit ID: home page, after services
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_BOTTOM=   # ad unit ID: home page, after reviews
# NEXT_PUBLIC_ADSENSE_SLOT_SERVICE_MID=   # ad unit ID: service pages, after the signs section
# NEXT_PUBLIC_ADSENSE_SLOT_SERVICE_BOTTOM=   # ad unit ID: service pages, after the FAQ
# NEXT_PUBLIC_ADSENSE_SLOT_CITY_MID=   # ad unit ID: city pages, after recent jobs
# NEXT_PUBLIC_ADSENSE_SLOT_CITY_BOTTOM=   # ad unit ID: city pages, after the FAQ
